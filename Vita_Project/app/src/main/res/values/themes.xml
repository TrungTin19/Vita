<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Base.Theme.Vita" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="toolbarStyle">@style/Widget.Vita.Figma.Toolbar</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.Vita.Figma.Back</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="editTextStyle">@style/Widget.Vita.Figma.EditText</item>
        <item name="textInputStyle">@style/Widget.Vita.AuthInput</item>
        <item name="colorSurface">@color/vita_surface</item>
        <item name="colorOnSurface">@color/vita_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vita_text_secondary</item>
        <item name="colorOutline">@color/vita_divider</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/vita_surface</item>
        <item name="colorPrimary">@color/vita_teal</item>
        <item name="colorPrimaryVariant">@color/vita_teal_dark</item>
        <item name="colorSecondary">@color/vita_aqua</item>
        <item name="colorSecondaryContainer">@color/vita_teal_50</item>
        <item name="android:statusBarColor">@color/vita_bg</item>
        <item name="android:windowBackground">@color/vita_bg</item>
    </style>
    <style name="Theme.Vita" parent="Base.Theme.Vita" />
    <style name="Widget.Vita.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_fg</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Vita.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/vita_teal</item>
        <item name="strokeColor">@color/vita_teal</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Vita.Button.Outlined.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/vita_status_danger</item>
        <item name="strokeColor">@color/vita_status_danger</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Vita.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card_resting</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>
    <style name="TextAppearance.Vita.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vita_text_primary</item>
    </style>
    <style name="TextAppearance.Vita.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/vita_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">22.4sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Vita.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vita_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">19.6sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Vita.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/vita_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">16.8sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
