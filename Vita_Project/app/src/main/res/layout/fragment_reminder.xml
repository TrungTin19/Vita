<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_reminder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_reminder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_scroll_pad">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_reminder_title"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_reminder_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/figma_reminder_subtitle"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btn_reminder_profile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/figma_ic_profile"
                    android:background="@drawable/figma_avatar_bg"
                    android:contentDescription="@string/profile_avatar_desc" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_notification_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:background="@color/vita_status_warning_bg"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_notification_permission"
                    android:text="@string/reminder_notifications_disabled"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_notification_settings"
                    style="@style/Widget.Vita.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_notifications_settings" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabs_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/tab_today_doses"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_today_doses"
                    style="@style/Widget.Vita.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="@string/figma_today_doses"
                    android:minHeight="@dimen/min_touch_target" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_medicine_list"
                    style="@style/Widget.Vita.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="@string/figma_medicine_list"
                    android:minHeight="@dimen/min_touch_target" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:id="@+id/layout_today_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_today_dose_heading"
                    android:text="@string/figma_today"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm" />
                <TextView
                    android:id="@+id/tv_reminder_today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vita_teal"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_today_doses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/spacing_sm"
                android:id="@+id/tv_medicine_list_heading"
                android:text="@string/dose_manage_title"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_medicines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_medicine" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_add_medicine"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="4dp"
                android:text="@string/figma_add_medicine"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />
            <TextView
                android:id="@+id/tv_reminder_list_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="20dp"
                android:background="@drawable/bg_soft_card"
                android:text="@string/figma_reminder_list_help"
                android:textColor="@color/vita_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />
            <LinearLayout
                android:id="@+id/layout_medicine_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_empty_notes"
                    app:tint="@color/vita_text_disabled" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/reminder_empty_title"
                    android:textColor="@color/vita_text_disabled"
                    android:textSize="@dimen/text_body_lg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/reminder_empty_desc"
                    android:textColor="@color/vita_text_disabled"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_dose_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="@string/figma_dose_overdue_help"
                android:textColor="@color/vita_text_secondary"
                android:textSize="13sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_water_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardBackgroundColor="@color/vita_water_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:importantForAccessibility="no"
                            android:src="@drawable/figma_ic_water"
                            app:tint="@color/vita_water" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_water_title"
                            android:textColor="@color/vita_text_primary"
                            android:textSize="@dimen/text_body_lg"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_water_progress_text"
                        android:minHeight="48dp"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:textColor="@color/vita_water"
                        android:textSize="@dimen/text_h1"
                        android:textStyle="bold"
                        tools:text="1,500 / 2,000 ml (75%)" />
                    <TextView
                        android:id="@+id/tv_water_adjustment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/vita_text_secondary" />
                    <ProgressBar
                        android:id="@+id/pb_water_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:max="2000"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_water" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_add_water"
                            style="@style/Widget.Vita.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:text="@string/reminder_btn_add_water"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_water_other_amount"
                            style="@style/Widget.Vita.Button.AuthSecondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/figma_home_custom"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reminder_water_journal"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_home_journal"
                        android:textColor="@color/vita_water"
                        android:paddingStart="0dp"
                        android:textAllCaps="false"
                        android:letterSpacing="0" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_water_settings"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/water_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
