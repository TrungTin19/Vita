<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/vita_surface"
        android:elevation="@dimen/elevation_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="@string/edit_profile_toolbar_title"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:id="@+id/scroll_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_scroll_pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/edit_profile_subtitle"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_fullname"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:hint="@string/edit_profile_hint_fullname"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_fullname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="@string/edit_profile_hint_fullname" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Birth Year and Gender Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_birth_year"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/edit_profile_hint_birth_year"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/register_helper_birth_year"
                    app:hintTextColor="@color/vita_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_birth_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="@string/edit_profile_hint_birth_year" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_gender"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/edit_profile_hint_gender"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText=" "
                    app:hintTextColor="@color/vita_teal">

                    <AutoCompleteTextView
                        android:id="@+id/act_edit_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Height and Weight Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_height"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/edit_profile_hint_height"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/register_helper_height"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/register_suffix_cm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="@string/edit_profile_hint_height" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_weight"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/edit_profile_hint_weight"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/register_helper_weight"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/register_suffix_kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="@string/edit_profile_hint_weight" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Water Goal -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_water_goal"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:hint="@string/edit_profile_hint_water_goal"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:helperText="@string/edit_profile_helper_water_goal"
                app:hintTextColor="@color/vita_teal"
                app:suffixText="@string/edit_profile_suffix_ml">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_water_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="@string/edit_profile_hint_water_goal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Changes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/edit_profile_btn_save" />

            <!-- Logout Button (Destructive Red) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_logout"
                style="@style/Widget.Vita.Button.Outlined.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/edit_profile_btn_logout" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
