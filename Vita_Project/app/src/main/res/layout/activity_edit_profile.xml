<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginBottom="36dp"
        android:background="@color/vita_bg"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:titleTextColor="@color/vita_text_primary">
        <TextView
            android:id="@+id/title_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Vita.Figma.Toolbar"
            android:text="@string/edit_profile_toolbar_title"
            android:accessibilityHeading="true" />
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        android:id="@+id/scroll_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/spacing_scroll_pad"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:id="@+id/group_profile_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_fullname"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/edit_profile_hint_fullname">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_fullname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_birth_year"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/edit_profile_hint_birth_year"
                    app:helperText="@string/register_helper_birth_year">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_birth_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="number"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_gender"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/edit_profile_hint_gender"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/act_edit_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="none"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_height"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/figma_edit_height"
                    app:suffixText="cm">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_weight"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/figma_edit_weight"
                    app:suffixText="kg">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_edit_weight_help"
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:padding="20dp"
                    android:background="@drawable/bg_soft_card"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/group_water_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_water_goal"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/figma_water_goal_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:suffixText="@string/edit_profile_suffix_ml">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_water_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="16sp"
                        tools:hint="@string/figma_water_goal_label"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_edit_water_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/figma_water_amount_label"
                    style="@style/Widget.Vita.AuthInput"
                    app:suffixText="ml">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_edit_water_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="number"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_edit_water_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/water_start"
                        style="@style/Widget.Vita.AuthInput"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_edit_water_start"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:inputType="none"
                            android:focusable="true"
                            android:cursorVisible="false"
                            android:clickable="true"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_edit_water_end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/water_end"
                        style="@style/Widget.Vita.AuthInput"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_edit_water_end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:inputType="none"
                            android:focusable="true"
                            android:cursorVisible="false"
                            android:clickable="true"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_water_mode_label"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <RadioGroup
                    android:id="@+id/rg_water_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <RadioButton
                        style="@style/Widget.Vita.AuthSegment"
                        android:id="@+id/rb_water_every_two_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/water_every_two_hours"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:gravity="start|center_vertical" />
                    <RadioButton
                        style="@style/Widget.Vita.AuthSegment"
                        android:id="@+id/rb_water_custom_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/water_custom_times"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:gravity="start|center_vertical" />
                </RadioGroup>
                <TextView
                    android:id="@+id/tv_water_schedule_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/vita_water_bg"
                    android:padding="20dp"
                    android:textColor="@color/vita_water"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="22.4sp"
                    android:gravity="center_vertical"
                    app:lineHeight="22.4sp" />
                <LinearLayout
                    android:id="@+id/group_water_custom_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="16dp"
                    android:background="@color/vita_water_bg"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/water_custom_help"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_body" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_water_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_water_time"
                        style="@style/Widget.Vita.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/water_add_time" />
                    <TextView
                        android:id="@+id/tv_water_times_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/vita_status_danger"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/water_settings_help"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/vita_text_secondary"
                    android:padding="16dp"
                    android:background="@color/vita_bg"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/figma_edit_save" />
            <LinearLayout
                android:id="@+id/group_profile_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_management"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_logout"
                    style="@style/Widget.Vita.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:text="@string/edit_profile_btn_logout" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_delete"
                    style="@style/Widget.Vita.Button.Outlined.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/profile_delete_title" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
