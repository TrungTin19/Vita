<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vita_bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_splash"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="36dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_teal"
        app:title="@string/app_name"
        app:titleTextColor="@color/vita_text_primary" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="114dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:id="@+id/ll_splash_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/iv_splash_logo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/figma_leaf"
                    android:contentDescription="@string/splash_logo_desc" />
                <TextView
                    android:id="@+id/tv_splash_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/splash_title"
                    android:textSize="64sp"
                    android:textColor="@color/vita_teal"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="89.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="89.6sp" />
                <TextView
                    android:id="@+id/tv_splash_slogan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_splash_title"
                    android:textSize="28sp"
                    android:textColor="@color/vita_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="39.2sp"
                    android:gravity="center_vertical"
                    app:lineHeight="39.2sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_splash_note"
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:padding="20dp"
                    android:background="@drawable/bg_soft_card"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
            </LinearLayout>
            <ProgressBar
                android:visibility="gone"
                android:id="@+id/pb_splash_loading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/vita_teal"
                android:layout_marginTop="24dp" />
            <TextView
                android:id="@+id/tv_splash_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_splash_footer"
                android:textSize="14sp"
                android:textColor="@color/vita_text_secondary"
                android:layout_marginTop="90dp"
                android:includeFontPadding="false"
                android:minHeight="19.6sp"
                android:gravity="center_vertical"
                app:lineHeight="19.6sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
