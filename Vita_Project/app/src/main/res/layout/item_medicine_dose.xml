<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="vertical">
    <TextView android:id="@+id/tv_dose_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/vita_text_primary" />
    <TextView android:id="@+id/tv_med_item_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_med_taken"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="@string/reminder_quick_taken" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_med_skipped"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:text="@string/reminder_quick_skipped" />
    </LinearLayout>
</LinearLayout>
