<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:id="@+id/root_health"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:minHeight="100dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_health_title"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_health_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/vita_text_secondary"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btn_health_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/figma_ic_profile"
                android:background="@drawable/figma_avatar_bg"
                android:contentDescription="@string/figma_health_profile"
                app:tint="@color/vita_teal" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_health_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/spacing_sm"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_health_clear_filter"
                style="@style/Widget.Vita.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/min_touch_target"
                android:text="@string/health_filter_all_dates"
                android:textColor="@color/vita_teal"
                tools:visibility="visible"
                android:layout_marginEnd="4dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_health_filter_date"
                style="@style/Widget.Vita.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch_target"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/figma_health_choose_range"
                android:textColor="@color/vita_text_primary"
                app:iconGravity="start"
                app:iconTint="@color/vita_teal"
                app:strokeColor="@color/vita_divider" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_health_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_sm"
            android:textColor="@color/vita_text_secondary"
            android:textSize="12sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_health_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="0dp"
            tools:listitem="@layout/item_health_record" />
        <LinearLayout
            android:id="@+id/layout_health_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:padding="24dp">
            <ImageView
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_empty_notes"
                app:tint="@color/vita_text_disabled" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:id="@+id/tv_health_empty_title"
                android:text="@string/health_empty_title"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_body_lg"
                android:gravity="center" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/health_empty_desc"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_body"
                android:gravity="center" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_add_health"
            style="@style/Widget.Vita.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginBottom="16dp"
            android:text="@string/figma_health_record"
            android:contentDescription="@string/health_fab_content_desc"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
