<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card_resting"
    app:cardUseCompatPadding="true"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bedtime"
            app:tint="@color/vita_sleep" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sleep_item_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold"
                tools:text="Đêm 08/10 → Sáng 09/10" />

            <TextView
                android:id="@+id/tv_sleep_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_body"
                tools:text="Ngủ: 23:00 – Thức: 06:30 (7.5 giờ)" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sleep_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_good"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:textColor="@color/vita_status_good"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            tools:text="Đủ giấc" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
