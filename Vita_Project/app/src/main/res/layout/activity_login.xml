<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vita_bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginBottom="36dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_teal"
        app:titleTextColor="@color/vita_text_primary">
        <TextView
            android:id="@+id/title_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Vita.Figma.Toolbar"
            android:text="@string/figma_login_toolbar"
            android:accessibilityHeading="true" />
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        android:id="@+id/scroll_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/vita_bg">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/iv_login_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/figma_leaf"
                android:contentDescription="@string/app_logo_content_desc" />
            <TextView
                android:id="@+id/tv_login_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_login_title"
                android:textSize="28sp"
                android:textColor="@color/vita_text_primary"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                android:minHeight="39.2sp"
                android:gravity="center_vertical"
                app:lineHeight="39.2sp" />
            <TextView
                android:id="@+id/tv_login_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_login_subtitle"
                android:textSize="16sp"
                android:textColor="@color/vita_text_secondary"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                android:minHeight="22.4sp"
                android:gravity="center_vertical"
                app:lineHeight="22.4sp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_login_username"
                style="@style/Widget.Vita.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/login_hint_username">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_login_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:textSize="16sp"
                    android:textColor="@color/vita_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_login_password"
                style="@style/Widget.Vita.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/login_hint_password"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:textSize="16sp"
                    android:textColor="@color/vita_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login_submit"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginBottom="16dp"
                android:text="@string/login_btn_submit" />
            <TextView
                android:id="@+id/tv_login_goto_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_create_account"
                android:textSize="16sp"
                android:textColor="@color/vita_teal"
                android:gravity="center"
                android:minHeight="52dp"
                android:background="@drawable/bg_mint_button"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                app:lineHeight="22.4sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_local_account"
                android:textSize="14sp"
                android:textColor="@color/vita_text_secondary"
                android:padding="20dp"
                android:background="@drawable/bg_soft_card"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                android:minHeight="19.6sp"
                android:gravity="center_vertical"
                app:lineHeight="19.6sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
