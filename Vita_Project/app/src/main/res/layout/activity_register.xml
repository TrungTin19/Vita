<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vita_bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginBottom="36dp"
        android:background="@color/vita_bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_teal"
        app:titleTextColor="@color/vita_text_primary">
        <TextView
            android:id="@+id/title_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Vita.Figma.Toolbar"
            android:text="@string/register_toolbar_title"
            android:accessibilityHeading="true" />
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        android:id="@+id/scroll_register"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:id="@+id/tv_register_step"
                android:layout_width="wrap_content"
                android:minWidth="100dp"
                android:layout_height="wrap_content"
                android:text="@string/figma_register_step_one"
                android:textSize="12sp"
                android:textColor="@color/vita_teal"
                android:background="@color/vita_mint"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                android:minHeight="16.8sp"
                android:gravity="center_vertical"
                app:lineHeight="16.8sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
            <TextView
                android:id="@+id/tv_register_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_register_title"
                android:textSize="28sp"
                android:textColor="@color/vita_text_primary"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp"
                android:includeFontPadding="false"
                android:minHeight="39.2sp"
                android:gravity="center_vertical"
                app:lineHeight="39.2sp" />
            <LinearLayout
                android:id="@+id/group_register_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_username"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_username">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_password"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_password"
                    app:helperText="@string/figma_password_minimum"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_confirm"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_confirm"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/group_register_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_fullname"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_fullname">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_fullname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_birth_year"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_birth_year"
                    app:helperText="@string/register_helper_birth_year">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_birth_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="number"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_gender"
                    style="@style/Widget.Vita.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/register_hint_gender"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/act_reg_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="none"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="16sp"
                        android:textColor="@color/vita_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reg_height"
                        style="@style/Widget.Vita.AuthInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/figma_edit_height"
                        app:suffixText="cm">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reg_height"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:imeOptions="actionNext"
                            android:textSize="16sp"
                            android:textColor="@color/vita_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reg_weight"
                        style="@style/Widget.Vita.AuthInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/figma_edit_weight"
                        app:suffixText="kg">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reg_weight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:imeOptions="actionNext"
                            android:textSize="16sp"
                            android:textColor="@color/vita_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_initial_weight_note"
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:padding="20dp"
                    android:background="@drawable/bg_soft_card"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reg_submit"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginBottom="16dp"
                android:text="@string/figma_register_next" />
            <TextView
                android:id="@+id/tv_register_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_register_local"
                android:textSize="14sp"
                android:textColor="@color/vita_text_secondary"
                android:padding="20dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:minHeight="19.6sp"
                android:gravity="center_vertical"
                app:lineHeight="19.6sp" />
            <TextView
                android:id="@+id/tv_reg_goto_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_link_login"
                android:textSize="14sp"
                android:textColor="@color/vita_teal"
                android:gravity="center"
                android:minHeight="48dp"
                android:includeFontPadding="false"
                app:lineHeight="19.6sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
