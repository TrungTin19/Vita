<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_medicine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/vita_surface"
        android:elevation="@dimen/elevation_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="@string/add_med_title_add"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Medicine Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_med_hint_name"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal"
                app:startIconDrawable="@drawable/ic_nav_medicines"
                app:startIconTint="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="Panadol Extra" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dosage -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_dosage"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_med_hint_dosage"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:helperText="@string/add_med_helper_dosage"
                app:hintTextColor="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_dosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="1 viên sau ăn sáng" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Time Picker Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_time"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_med_hint_time"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal"
                app:startIconDrawable="@drawable/ic_notifications"
                app:startIconTint="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="08:00" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Days Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/add_med_section_days"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- 7 Day Buttons -->
            <LinearLayout
                android:id="@+id/layout_med_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_mon"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_mon"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_tue"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_tue"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_wed"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_wed"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_thu"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_thu"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_fri"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_fri"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_sat"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_sat"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_day_sun"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/add_med_day_sun"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_pill" />
            </LinearLayout>

            <!-- Daily CheckBox -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_med_all_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/add_med_all_days"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_body"
                app:boxBackgroundColor="@color/vita_teal" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_med_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/add_med_btn_save" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
