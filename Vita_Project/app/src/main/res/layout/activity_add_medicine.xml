<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_medicine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="@color/vita_bg"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:titleTextColor="@color/vita_text_primary">
        <TextView
            android:id="@+id/title_add_medicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Vita.Figma.Toolbar"
            android:text="@string/add_med_title_add"
            android:accessibilityHeading="true" />
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_name"
                style="@style/Widget.Vita.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/figma_medicine_name_label"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:startIconTint="@color/vita_teal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="Panadol Extra" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_dosage"
                style="@style/Widget.Vita.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/figma_medicine_dosage_label"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_dosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="1 viên sau ăn sáng" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/figma_medicine_times"
                android:textColor="@color/vita_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_med_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_med_time"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:hintEnabled="false"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@color/vita_mint"
                app:expandedHintEnabled="false"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_divider"
                app:hintTextColor="@color/vita_teal"
                app:startIconTint="@color/vita_teal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_med_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="true"
                    android:inputType="none"
                    android:textColor="@color/vita_teal"
                    android:textSize="16sp"
                    android:gravity="center"
                    tools:hint="08:00" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/figma_medicine_times_help"
                android:textColor="@color/vita_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/figma_medicine_days"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
            <GridLayout
                android:id="@+id/layout_med_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:columnCount="4">
                <CheckBox
                    android:id="@+id/btn_day_mon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_mon"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_tue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_tue"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_wed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_wed"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_thu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_thu"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_fri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_fri"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_sat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_sat"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox
                    android:id="@+id/btn_day_sun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:padding="8dp"
                    android:button="@null"
                    android:layout_marginBottom="8dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_day_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/add_med_day_sun"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </GridLayout>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_med_all_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/add_med_all_days"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_body"
                app:boxBackgroundColor="@color/vita_teal" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/figma_medicine_schedule_help"
                android:textSize="14sp"
                android:textColor="@color/vita_text_secondary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_med_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/figma_save_schedule" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
