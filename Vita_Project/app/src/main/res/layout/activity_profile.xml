<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_profile"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="36dp"
        android:background="@color/vita_bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_teal"
        app:title="@string/profile_toolbar_title"
        app:titleTextColor="@color/vita_text_primary" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <LinearLayout
                android:id="@+id/group_profile_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Vita.Card"
                    app:contentPadding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/vita_teal_dark"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:id="@+id/iv_profile_avatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/figma_ic_profile"
                            app:tint="@color/vita_surface"
                            android:contentDescription="@string/profile_avatar_desc" />
                        <TextView
                            android:id="@+id/tv_profile_fullname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_default_user"
                            android:textSize="28sp"
                            android:textColor="@color/vita_surface"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            android:includeFontPadding="false"
                            android:minHeight="39.2sp"
                            android:gravity="center_vertical"
                            app:lineHeight="39.2sp" />
                        <TextView
                            android:id="@+id/tv_profile_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textSize="14sp"
                            android:textColor="@color/vita_surface"
                            android:layout_marginTop="12dp"
                            android:includeFontPadding="false"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            app:lineHeight="19.6sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/figma_profile_local"
                            android:textSize="12sp"
                            android:textColor="@color/vita_surface"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:minHeight="16.8sp"
                            android:gravity="center_vertical"
                            app:lineHeight="16.8sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_profile_personal"
                        android:textSize="18sp"
                        android:textColor="@color/vita_text_primary"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:minHeight="25.2sp"
                        android:gravity="center_vertical"
                        app:lineHeight="25.2sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_profile_edit"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/figma_edit_action"
                        android:textColor="@color/vita_teal"
                        android:textSize="14sp" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_profile_stats"
                    style="@style/Widget.Vita.Card"
                    app:contentPadding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/vita_surface"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_label_birth_year"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:minHeight="16.8sp"
                                android:gravity="center_vertical"
                                app:lineHeight="16.8sp" />
                            <TextView
                                android:id="@+id/tv_profile_birth_year"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="—"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="14sp"
                                android:includeFontPadding="false"
                                android:minHeight="19.6sp"
                                android:gravity="center_vertical"
                                app:lineHeight="19.6sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_label_gender"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:minHeight="16.8sp"
                                android:gravity="center_vertical"
                                app:lineHeight="16.8sp" />
                            <TextView
                                android:id="@+id/tv_profile_gender"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="—"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="14sp"
                                android:includeFontPadding="false"
                                android:minHeight="19.6sp"
                                android:gravity="center_vertical"
                                app:lineHeight="19.6sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_label_height"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:minHeight="16.8sp"
                                android:gravity="center_vertical"
                                app:lineHeight="16.8sp" />
                            <TextView
                                android:id="@+id/tv_profile_height"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="—"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="14sp"
                                android:includeFontPadding="false"
                                android:minHeight="19.6sp"
                                android:gravity="center_vertical"
                                app:lineHeight="19.6sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_label_base_weight"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:minHeight="16.8sp"
                                android:gravity="center_vertical"
                                app:lineHeight="16.8sp" />
                            <TextView
                                android:id="@+id/tv_profile_base_weight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="—"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="14sp"
                                android:includeFontPadding="false"
                                android:minHeight="19.6sp"
                                android:gravity="center_vertical"
                                app:lineHeight="19.6sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="0dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/figma_profile_latest_weight_label"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="12sp"
                                android:includeFontPadding="false"
                                android:minHeight="16.8sp"
                                android:gravity="center_vertical"
                                app:lineHeight="16.8sp" />
                            <TextView
                                android:id="@+id/tv_profile_latest_weight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="14sp"
                                android:includeFontPadding="false"
                                android:minHeight="19.6sp"
                                android:gravity="center_vertical"
                                app:lineHeight="19.6sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_open_bmi"
                    style="@style/Widget.Vita.Button.AuthSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/figma_profile_bmi_open" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_water_settings"
                    style="@style/Widget.Vita.Button.AuthSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/figma_profile_water_open" />
                <TextView
                    android:id="@+id/tv_profile_water_goal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
                <TextView
                    android:id="@+id/tv_profile_water_schedule"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/group_profile_bmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_profile_bmi_config"
                    style="@style/Widget.Vita.Card"
                    app:contentPadding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/vita_teal_dark"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/figma_bmi_current_label"
                            android:textSize="12sp"
                            android:textColor="@color/vita_surface"
                            android:includeFontPadding="false"
                            android:minHeight="16.8sp"
                            android:gravity="center_vertical"
                            app:lineHeight="16.8sp" />
                        <TextView
                            android:id="@+id/tv_profile_bmi_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="64sp"
                            android:textColor="@color/vita_surface"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:minHeight="89.6sp"
                            android:gravity="center_vertical"
                            app:lineHeight="89.6sp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />
                        <TextView
                            android:id="@+id/tv_profile_bmi_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_bmi_undetermined"
                            android:textSize="14sp"
                            android:textColor="@color/vita_teal"
                            android:padding="8dp"
                            android:background="@color/vita_mint"
                            android:includeFontPadding="false"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            app:lineHeight="19.6sp" />
                        <TextView
                            android:id="@+id/tv_profile_weight_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="@color/vita_surface"
                            android:layout_marginTop="16dp"
                            android:includeFontPadding="false"
                            android:minHeight="19.6sp"
                            android:gravity="center_vertical"
                            app:lineHeight="19.6sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_bmi_standard_label"
                    android:textSize="18sp"
                    android:textColor="@color/vita_text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="25.2sp"
                    android:gravity="center_vertical"
                    app:lineHeight="25.2sp" />
                <RadioGroup
                    android:id="@+id/rg_bmi_standard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <RadioButton
                        style="@style/Widget.Vita.AuthSegment"
                        android:id="@+id/rb_bmi_asian"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/home_bmi_standard_asian" />
                    <RadioButton
                        style="@style/Widget.Vita.AuthSegment"
                        android:id="@+id/rb_bmi_who"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/figma_bmi_who" />
                </RadioGroup>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Vita.Card"
                    app:contentPadding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/vita_surface"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/figma_bmi_weight_range_label"
                            android:textSize="12sp"
                            android:textColor="@color/vita_text_secondary"
                            android:layout_marginBottom="12dp"
                            android:includeFontPadding="false"
                            android:minHeight="16.8sp"
                            android:gravity="center_vertical"
                            app:lineHeight="16.8sp" />
                        <TextView
                            android:id="@+id/tv_profile_healthy_weight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/vita_text_primary"
                            android:includeFontPadding="false"
                            android:minHeight="33.6sp"
                            android:gravity="center_vertical"
                            app:lineHeight="33.6sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bmi_standards_help"
                    android:textSize="14sp"
                    android:textColor="@color/vita_text_secondary"
                    android:padding="20dp"
                    android:background="@color/vita_bg"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bmi_add_weight"
                    style="@style/Widget.Vita.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/figma_bmi_add_weight" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/group_profile_account_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_management"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/vita_text_primary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_logout"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/edit_profile_btn_logout"
                    android:textColor="@color/vita_teal"
                    android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_delete"
                    style="@style/Widget.Vita.Button.AuthDanger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/profile_delete_title" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
