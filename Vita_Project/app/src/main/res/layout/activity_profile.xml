<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_profile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/vita_surface"
        android:elevation="@dimen/elevation_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="@string/profile_toolbar_title"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_scroll_pad">

            <!-- Avatar & User Info Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/profile_avatar_desc"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile_user" />

                <TextView
                    android:id="@+id/tv_profile_fullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/profile_default_user"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_h1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_profile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/app_name"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Card 1: Body Physical Stats (Label-Value Grid) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_profile_stats"
                style="@style/Widget.Vita.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/profile_section_physical"
                        android:textColor="@color/vita_teal"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <!-- Row 1: Birth Year and Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Item Birth Year -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_birth_year"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_profile_birth_year"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="--"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="@dimen/text_body_lg"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Item Gender -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_gender"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_profile_gender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="--"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="@dimen/text_body_lg"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:background="@color/vita_divider" />

                    <!-- Row 2: Height and Base Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Item Height -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_height"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_profile_height"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="-- cm"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="@dimen/text_body_lg"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Item Weight -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_base_weight"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_profile_base_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="-- kg"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="@dimen/text_body_lg"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:background="@color/vita_divider" />

                    <!-- Row 3: Water Goal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_water_goal"
                            android:textColor="@color/vita_text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_profile_water_goal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="2,000 ml / ngày"
                            android:textColor="@color/vita_water"
                            android:textSize="@dimen/text_body_lg"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: BMI Analysis & Standard Selection -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_profile_bmi_config"
                style="@style/Widget.Vita.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/profile_section_bmi"
                        android:textColor="@color/vita_teal"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <!-- Visual BMI Status Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/vita_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_sm">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_current_bmi"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/tv_profile_bmi_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/vita_text_primary"
                                android:textSize="@dimen/text_display"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Category Badge -->
                        <TextView
                            android:id="@+id/tv_profile_bmi_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_rounded"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingTop="@dimen/spacing_xs"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:paddingBottom="@dimen/spacing_xs"
                            android:text="@string/profile_bmi_undetermined"
                            android:textColor="@color/vita_teal"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Healthy Target Weight Hint -->
                    <TextView
                        android:id="@+id/tv_profile_healthy_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Khoảng cân nặng hợp lý: --"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_body" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:background="@color/vita_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/profile_label_bmi_standard"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_bmi_standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rb_bmi_asian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingEnd="0dp"
                            android:text="@string/profile_standard_asian"
                            android:textColor="@color/vita_text_primary"
                            android:textSize="@dimen/text_body" />

                        <RadioButton
                            android:id="@+id/rb_bmi_who"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingEnd="0dp"
                            android:text="@string/profile_standard_who"
                            android:textColor="@color/vita_text_primary"
                            android:textSize="@dimen/text_body" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_edit"
                style="@style/Widget.Vita.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/profile_btn_edit" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
