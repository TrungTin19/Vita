<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_profile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/vita_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="Hồ sơ cá nhân"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar & User Info Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/spinner_border"
                    android:contentDescription="Ảnh đại diện"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/vita_logo_art" />

                <TextView
                    android:id="@+id/tv_profile_fullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Người dùng Vita"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_profile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@username"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 1: Body Physical Stats -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_profile_stats"
                style="@style/Widget.Vita.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/vita_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/vita_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="THÔNG SỐ CƠ THỂ"
                        android:textColor="@color/vita_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_birth_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="• Năm sinh: Đang cập nhật"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_profile_gender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="• Giới tính: Nam"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_profile_height"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="• Chiều cao: -- cm"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_profile_base_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="• Cân nặng ban đầu: -- kg"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_profile_water_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Mục tiêu nước: 2,000 ml/ngày"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: BMI Standard Selection -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_profile_bmi_config"
                style="@style/Widget.Vita.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/vita_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/vita_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="CHUẨN PHÂN LOẠI BMI"
                        android:textColor="@color/vita_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_bmi_standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rb_bmi_asian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:text="Chuẩn Châu Á (IDI &amp; WPRO)\nKhuyến nghị cho người Việt Nam"
                            android:textColor="@color/vita_text_primary"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rb_bmi_who"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:text="Chuẩn Quốc tế (WHO)\nÁp dụng đa chủng tộc toàn cầu"
                            android:textColor="@color/vita_text_primary"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_edit"
                style="@style/Widget.Vita.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minHeight="48dp"
                android:text="CHỈNH SỬA HỒ SƠ"
                android:textAllCaps="true"
                android:textColor="@color/vita_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="@color/vita_teal" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
