<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingTop="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_delete_profile_password"
        style="@style/Widget.Vita.AuthInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/figma_delete_profile_password"
        app:placeholderText="@string/figma_delete_profile_placeholder">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_delete_profile_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
