<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        android:paddingStart="@dimen/figma_screen_gutter"
        android:paddingEnd="@dimen/figma_screen_gutter">
        <TextView
            android:id="@+id/tv_home_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Vita.Title"
            android:textSize="25sp"
            android:layout_marginTop="0dp"
            android:minHeight="35sp"
            android:gravity="center_vertical"
            app:lineHeight="35sp"
            android:includeFontPadding="false"
            android:letterSpacing="0" />
        <TextView
            android:id="@+id/tv_home_sub_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/figma_home_subtitle"
            android:textAppearance="@style/TextAppearance.Vita.Secondary"
            android:textSize="16sp"
            android:minHeight="22.4sp"
            android:gravity="center_vertical"
            app:lineHeight="22.4sp"
            android:includeFontPadding="false"
            android:letterSpacing="0" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home_add_health"
            style="@style/Widget.Vita.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/figma_home_record"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            android:layout_marginTop="16dp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/vita_teal_dark"
            app:strokeWidth="0dp"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/figma_ic_medicine"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_next_dose"
                        android:textColor="@color/vita_mint"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:minHeight="19.6sp"
                        android:gravity="center_vertical"
                        app:lineHeight="19.6sp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_home_next_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:minHeight="47.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="47.6sp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0" />
                <TextView
                    android:id="@+id/tv_home_next_dose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:minHeight="28sp"
                    android:gravity="center_vertical"
                    app:lineHeight="28sp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0" />
                <TextView
                    android:id="@+id/tv_home_next_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vita_mint"
                    android:textSize="14sp"
                    android:minHeight="19.6sp"
                    android:gravity="center_vertical"
                    app:lineHeight="19.6sp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_reminders"
                    style="@style/Widget.Vita.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/figma_home_reminders"
                    android:textColor="@color/vita_teal"
                    app:backgroundTint="@color/vita_mint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/vita_water_bg"
            app:strokeWidth="0dp"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/figma_ic_water"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_water_title"
                        android:textAppearance="@style/TextAppearance.Vita.Body"
                        android:textStyle="bold"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:minHeight="25.2sp"
                        android:gravity="center_vertical"
                        app:lineHeight="25.2sp"
                        android:includeFontPadding="false" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tv_home_water_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="16"
                        android:textColor="@color/vita_water"
                        android:textStyle="bold"
                        android:textSize="40sp"
                        android:minHeight="56sp"
                        android:gravity="center_vertical"
                        app:lineHeight="56sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0" />
                    <TextView
                        android:id="@+id/tv_home_water_goal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Vita.Caption"
                        android:textSize="14sp"
                        android:minHeight="19.6sp"
                        android:gravity="center_vertical"
                        app:lineHeight="19.6sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:layout_weight="11" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/pb_home_water"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progressDrawable="@drawable/progress_water"
                    android:indeterminateOnly="false"
                    android:minHeight="8dp"
                    android:maxHeight="8dp" />
                <TextView
                    android:id="@+id/tv_home_water_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Vita.Caption"
                    android:textColor="@color/vita_water" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_home_add_water"
                        style="@style/Widget.Vita.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_home_custom_water"
                        style="@style/Widget.Vita.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/figma_home_custom"
                        android:textColor="@color/vita_teal"
                        app:backgroundTint="@color/vita_mint" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_water_journal"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:text="@string/figma_home_journal"
                    android:textColor="@color/vita_water"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/vita_divider"
            app:strokeWidth="1dp"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:id="@+id/tv_home_latest_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Vita.Body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_latest_record"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/home_open_record"
                    android:paddingStart="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_home_bmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_bmi_title"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/vita_mint"
            app:strokeWidth="0dp"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_bmi_title"
                    android:textAppearance="@style/TextAppearance.Vita.Body"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tv_home_bmi_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="32sp"
                        android:textColor="@color/vita_teal"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_home_bmi_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Vita.Secondary" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_home_bmi_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Vita.Secondary" />
                <TextView
                    android:id="@+id/tv_home_bmi_standard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Vita.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
