<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_scroll_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Greeting -->
        <TextView
            android:id="@+id/tv_home_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:textColor="@color/vita_text_primary"
            android:textSize="@dimen/text_h1"
            android:textStyle="bold"
            tools:text="Chào buổi sáng, bạn!" />

        <TextView
            android:id="@+id/tv_home_sub_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:paddingHorizontal="@dimen/spacing_md"
            android:text="@string/home_sub_greeting"
            android:textColor="@color/vita_text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- BMI Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_home_bmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card_resting"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/home_bmi_title"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_home_bmi_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/vita_teal"
                        android:textSize="@dimen/text_display"
                        android:textStyle="bold"
                        tools:text="22.4" />

                    <TextView
                        android:id="@+id/tv_home_bmi_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_good"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:textColor="@color/vita_status_good"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        tools:text="Bình thường" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_bmi_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body"
                    tools:text="Chiều cao: 165 cm • Cân nặng: 61 kg" />

                <TextView
                    android:id="@+id/tv_home_bmi_standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="@dimen/text_caption"
                    tools:text="Chuẩn đánh giá: Châu Á" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weather Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_home_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card_resting"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/home_weather_title"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/sp_home_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:minHeight="@dimen/min_touch_target" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_home_temp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_display"
                        android:textStyle="bold"
                        tools:text="33°C" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_home_aqi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vita_status_good"
                            android:textSize="@dimen/text_h2"
                            android:textStyle="bold"
                            tools:text="AQI: 65" />

                        <TextView
                            android:id="@+id/tv_home_aqi_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vita_text_secondary"
                            android:textSize="@dimen/text_caption"
                            tools:text="Không khí tốt" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_humidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/vita_text_secondary"
                    android:textSize="@dimen/text_body"
                    tools:text="Độ ẩm: 68%" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_home_updated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="Cập nhật: 08:30" />

                    <TextView
                        android:id="@+id/tv_home_offline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_neutral"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:text="@string/home_offline_label"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Advice Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_home_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardBackgroundColor="@color/vita_aqua_light"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card_resting"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/vita_divider"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/home_advice_title"
                    android:textColor="@color/vita_teal"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_home_advice_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:text="Hôm nay trời nắng nóng 33°C. Vita gợi ý bạn nên bổ sung thêm 300 ml nước nhé." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
