<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_health"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/vita_surface"
        android:elevation="@dimen/elevation_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="@string/add_health_title_add"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:id="@+id/scroll_add_health"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Date Picker Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_add_health_date"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_health_hint_date"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_add_health_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="Ngày đo (dd/MM/yyyy)" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION 1: HUYẾT ÁP & TIM MẠCH -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/add_health_section_bp"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- Systolic & Diastolic Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_add_systolic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_health_hint_systolic"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/add_health_helper_systolic"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/add_health_suffix_mmhg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_add_systolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_add_diastolic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_health_hint_diastolic"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/add_health_helper_diastolic"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/add_health_suffix_mmhg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_add_diastolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="80" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Heart Rate -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_add_heart_rate"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_health_hint_hr"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:helperText="@string/add_health_helper_hr"
                app:hintTextColor="@color/vita_teal"
                app:suffixText="@string/add_health_suffix_bpm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_add_heart_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="75" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECTION 2: THỂ TRẠNG & ĐƯỜNG HUYẾT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/add_health_section_body"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- Weight & Blood Sugar Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_add_weight"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_health_hint_weight"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/add_health_helper_weight"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/add_health_suffix_kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_add_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="62.5" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_add_sugar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_health_hint_sugar"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:helperText="@string/add_health_helper_sugar"
                    app:hintTextColor="@color/vita_teal"
                    app:suffixText="@string/add_health_suffix_sugar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_add_sugar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="95.0" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SECTION 3: GHI CHÚ BỔ SUNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/add_health_section_notes"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_add_note"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_health_hint_notes"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_add_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxLines="5"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body"
                    tools:hint="Ví dụ: Đo sau khi uống thuốc huyết áp 30 phút, cảm thấy hơi mệt..." />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Helper Text Notice (Nullable Guidance) -->
            <TextView
                android:id="@+id/tv_add_health_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:drawablePadding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:text="@string/add_health_guidance_nullable"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_caption"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/vita_teal" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_health_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/add_health_btn_save" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
