<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_stats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_scroll_pad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/stats_title"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <!-- Time Range Toggle -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_time_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:checkedButton="@+id/btn_range_7"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_range_7"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_weight="1"
                    android:text="@string/stats_range_7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_range_30"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_weight="1"
                    android:text="@string/stats_range_30" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_weight_title"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_teal"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_weight"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:contentDescription="@string/stats_weight_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_heart_rate_title"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_teal"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_heart_rate"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:contentDescription="@string/stats_heart_rate_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_glucose_title"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_teal"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_glucose"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:contentDescription="@string/stats_glucose_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- BP LineChart Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_chart_bp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/stats_bp_title"
                        android:textColor="@color/vita_teal"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/stats_bp_legend"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_bp"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Water BarChart Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_chart_water"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/stats_water_title"
                        android:textColor="@color/vita_teal"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_water_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="Mục tiêu: 2,000 ml/ngày" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_water"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sleep BarChart Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_chart_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/stats_sleep_chart_title"
                        android:textColor="@color/vita_sleep"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_sleep"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sleep History Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/stats_sleep_section"
                android:textColor="@color/vita_teal"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sleep_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_sleep_record" />

            <TextView
                android:id="@+id/tv_sleep_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:text="@string/stats_sleep_empty"
                android:textColor="@color/vita_text_disabled"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_sleep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_scroll_pad"
        android:contentDescription="@string/stats_fab_desc"
        app:backgroundTint="@color/btn_fab_bg"
        app:elevation="@dimen/elevation_fab"
        app:srcCompat="@drawable/ic_bedtime"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
