<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_stats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_scroll_pad">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:minHeight="100dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_stats_title"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_stats_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/vita_text_secondary"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btn_stats_profile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/figma_ic_profile"
                    android:background="@drawable/figma_avatar_bg"
                    android:contentDescription="@string/figma_health_profile"
                    app:tint="@color/vita_teal" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/vita_surface"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/vita_divider"
                app:cardUseCompatPadding="false"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_stats_metric"
                        android:textSize="12sp"
                        android:textColor="@color/vita_text_secondary" />
                    <Spinner
                        android:id="@+id/sp_stats_metric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:contentDescription="@string/stats_choose_metric"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_time_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:checkedButton="@+id/btn_range_7"
                app:selectionRequired="true"
                app:singleSelection="true"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_range_7"
                    style="@style/Widget.Vita.Health.Segment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_weight="1"
                    android:text="@string/figma_stats_range_7" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_range_30"
                    style="@style/Widget.Vita.Health.Segment"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_weight="1"
                    android:text="@string/figma_stats_range_30" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_health_input"
                android:paddingTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/figma_stats_context"
                    android:textSize="12sp"
                    android:textColor="@color/vita_text_secondary" />
                <Spinner
                    android:id="@+id/sp_stats_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:contentDescription="@string/stats_choose_context" />
            </LinearLayout>
            <include
                layout="@layout/stats_empty_state" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_surface"
                app:cardUseCompatPadding="false"
                android:id="@+id/card_stats_latest"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_stats_latest"
                        android:textSize="12sp"
                        android:textColor="@color/vita_text_secondary" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/tv_stats_latest_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/vita_text_primary" />
                        <TextView
                            android:id="@+id/tv_stats_latest_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/vita_text_secondary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_stats_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                    <TextView
                        android:id="@+id/tv_stats_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_good"
                        android:textColor="@color/vita_teal"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="@color/vita_surface"
                app:strokeWidth="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_chart_weight"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_text_primary"
                        android:textStyle="bold"
                        android:id="@+id/tv_stats_weight_chart_title" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_weight"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="@string/stats_weight_title" />
                    <TextView
                        android:id="@+id/tv_stats_weight_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/figma_stats_one_help"
                        android:textAppearance="@style/TextAppearance.Vita.Caption"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="@color/vita_surface"
                app:strokeWidth="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_chart_hr"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_text_primary"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_heart_rate"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="@string/stats_heart_rate_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="@color/vita_surface"
                app:strokeWidth="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/figma_chart_sugar"
                        android:textSize="@dimen/text_body_lg"
                        android:textColor="@color/vita_text_primary"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_glucose"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="@string/stats_glucose_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_chart_bp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_surface"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/figma_chart_bp"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_bp"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="@string/stats_bp_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_chart_water"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_surface"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/figma_chart_water"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_water_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="Mục tiêu: 2,000 ml/ngày" />
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_water"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="@string/stats_water_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tv_stats_chart_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:background="@drawable/bg_badge_rounded"
                android:textSize="14sp"
                android:textColor="@color/vita_text_secondary"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stats_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_view_data"
                style="@style/Widget.Vita.Health.DataButton"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
