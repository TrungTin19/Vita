<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">
    <include
        android:id="@+id/toolbar_detail_health"
        layout="@layout/view_page_toolbar" />
    <ScrollView
        android:id="@+id/scroll_detail_health"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:id="@+id/tv_detail_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:drawablePadding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:textColor="@color/vita_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableTint="@color/vita_teal"
                tools:text="Ngày đo: 09/10/2026" />
            <TextView
                android:id="@+id/tv_detail_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_badge_good"
                android:textSize="12sp"
                android:textColor="@color/vita_teal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_detail_bp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/vita_surface"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:id="@+id/layout_detail_bp_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/figma_health_bp_label"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:layout_marginBottom="12dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tv_detail_bp_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/vita_text_primary"
                                    android:textSize="36sp"
                                    android:textStyle="bold"
                                    tools:text="125 / 82" />
                                <TextView
                                    android:id="@+id/tv_detail_bp_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/detail_health_bp_unit"
                                    android:textColor="@color/vita_text_secondary"
                                    android:textSize="14sp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tv_detail_bp_previous"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:lineSpacingExtra="4dp" />
                            <TextView
                                android:id="@+id/tv_detail_bp_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_good"
                                android:textColor="@color/vita_status_good"
                                android:textSize="14sp"
                                tools:text="Bình thường"
                                android:paddingStart="@dimen/spacing_sm"
                                android:paddingEnd="@dimen/spacing_sm"
                                android:paddingTop="@dimen/spacing_xs"
                                android:paddingBottom="@dimen/spacing_xs"
                                android:layout_marginTop="12dp"
                                android:minHeight="48dp"
                                android:gravity="center_vertical" />
                            <TextView
                                android:id="@+id/tv_detail_bp_advice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:textColor="@color/vita_text_secondary"
                                android:textSize="@dimen/text_body"
                                tools:text="Đánh giá: Huyết áp ổn định"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <View
                        android:id="@+id/divider_detail_bp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@color/vita_divider"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/vita_surface"
                        app:strokeWidth="0dp"
                        android:id="@+id/card_detail_weight">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/figma_health_weight_label"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:layout_marginBottom="12dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="start">
                                <TextView
                                    android:id="@+id/tv_detail_weight"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/vita_text_primary"
                                    android:textSize="36sp"
                                    tools:text="• Cân nặng: 61.5 kg"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_health_suffix_kg"
                                    android:textAppearance="@style/TextAppearance.Vita.Caption"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tv_detail_weight_previous"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/vita_surface"
                        app:strokeWidth="0dp"
                        android:id="@+id/card_detail_hr">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/figma_health_hr_label"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:layout_marginBottom="12dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="start">
                                <TextView
                                    android:id="@+id/tv_detail_heart_rate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/vita_text_primary"
                                    android:textSize="36sp"
                                    tools:text="Nhịp tim: 76 bpm (Bình thường)"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_health_suffix_bpm"
                                    android:textAppearance="@style/TextAppearance.Vita.Caption"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tv_detail_hr_previous"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/vita_surface"
                        app:strokeWidth="0dp"
                        android:id="@+id/card_detail_sugar">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/figma_health_sugar_label"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:layout_marginBottom="12dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="start">
                                <TextView
                                    android:id="@+id/tv_detail_sugar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/vita_text_primary"
                                    android:textSize="36sp"
                                    tools:text="• Đường huyết: 95.0 mg/dL"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_health_suffix_sugar"
                                    android:textAppearance="@style/TextAppearance.Vita.Caption"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tv_detail_sugar_previous"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/vita_text_secondary"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_detail_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/vita_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/detail_health_section_notes"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_detail_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body"
                        tools:text="Đo sau bữa sáng 30 phút, cơ thể cảm thấy khỏe khoắn." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/detail_health_disclaimer"
                android:textColor="@color/vita_text_disabled"
                android:textSize="@dimen/text_caption"
                android:textStyle="italic" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_edit"
                style="@style/Widget.Vita.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:text="@string/detail_health_btn_edit"
                android:textColor="@color/vita_teal"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconTint="@color/vita_teal"
                app:strokeColor="@color/vita_teal" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
