<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vita_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_sleep"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/vita_surface"
        android:elevation="@dimen/elevation_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/a11y_navigate_back"
        app:navigationIconTint="@color/vita_text_primary"
        app:title="@string/add_sleep_title"
        app:titleTextColor="@color/vita_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Moon Icon -->
            <ImageView
                android:id="@+id/iv_sleep_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:contentDescription="@string/add_sleep_icon_desc"
                android:src="@drawable/ic_bedtime"
                app:tint="@color/vita_sleep" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/add_sleep_heading"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_md"
                android:gravity="center"
                android:text="@string/add_sleep_subtitle"
                android:textColor="@color/vita_text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Wake Date -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_sleep_date"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/add_sleep_hint_date"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                app:boxCornerRadiusBottomStart="@dimen/radius_input"
                app:boxCornerRadiusTopEnd="@dimen/radius_input"
                app:boxCornerRadiusTopStart="@dimen/radius_input"
                app:boxStrokeColor="@color/vita_teal"
                app:hintTextColor="@color/vita_teal"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/vita_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_sleep_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/vita_text_primary"
                    android:textSize="@dimen/text_body_lg"
                    tools:hint="14/10/2026" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sleep / Wake Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_sleep_time"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_sleep_hint_sleep_time"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:hintTextColor="@color/vita_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_sleep_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="23:00" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_wake_time"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/add_sleep_hint_wake_time"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxStrokeColor="@color/vita_teal"
                    app:hintTextColor="@color/vita_teal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_wake_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/vita_text_primary"
                        android:textSize="@dimen/text_body_lg"
                        tools:hint="06:30" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Duration Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_sleep_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card_resting"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/add_sleep_result_title"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_sleep_duration_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:textColor="@color/vita_sleep"
                            android:textSize="@dimen/text_display"
                            android:textStyle="bold"
                            tools:text="7.5 giờ" />

                        <TextView
                            android:id="@+id/tv_sleep_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_good"
                            android:paddingHorizontal="@dimen/spacing_sm"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textColor="@color/vita_status_good"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold"
                            tools:text="Đủ giấc" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sleep_advice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:textColor="@color/vita_text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sleep_save"
                style="@style/Widget.Vita.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/add_sleep_btn_save" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
