<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_medicine_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="0dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/figma_ic_medicine"
                app:tint="@color/vita_teal" />
            <TextView
                android:id="@+id/tv_med_item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/vita_text_primary"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold"
                tools:text="Panadol Extra" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_med_item_dosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/vita_text_secondary" />
        <TextView
            android:id="@+id/tv_med_item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/vita_text_secondary"
            android:textSize="@dimen/text_body"
            tools:text="08:00 • 1 viên sau ăn sáng" />
        <TextView
            android:id="@+id/tv_med_item_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/vita_text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="Lặp lại: T2, T3, T4, T5, T6, T7, CN" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sw_med_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/vita_mint"
            android:textColor="@color/vita_teal"
            android:checkable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_med_history"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/figma_medicine_detail_history"
            app:backgroundTint="@color/vita_mint"
            app:cornerRadius="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
